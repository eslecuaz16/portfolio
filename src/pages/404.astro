---
import Layout from '../layouts/Layout.astro';
import { getUi } from '../i18n/ui';

const t = getUi('es');
---
<Layout locale="es">
  <section class="section notfound">
    <div class="container">
      <div class="code-window notfound-window reveal visible">
        <div class="code-bar">
          <span class="dot dot-r"></span>
          <span class="dot dot-y"></span>
          <span class="dot dot-g"></span>
          <span class="code-fname">404.ts</span>
        </div>
        <div class="code-body">
<span class="kw">throw new</span> <span class="fn">Error</span><span class="op">(</span><span class="str">'Route not found'</span><span class="op">)</span><br>
<br>
<span class="cm">// {t.notFound.desc}</span><span class="type-cursor"></span>
        </div>
      </div>

      <h1 class="notfound-title">404 — {t.notFound.title}</h1>
      <p class="notfound-desc">{t.notFound.desc}</p>
      <a href="/" class="btn btn-primary">{t.notFound.cta}</a>
    </div>
  </section>
</Layout>

<style>
.notfound {
  min-height: 70vh;
  display: flex;
  align-items: center;
}
.notfound .container { text-align: center; }
.notfound-window {
  max-width: 480px;
  margin: 0 auto 2.5rem;
  text-align: left;
  box-shadow: 0 32px 80px rgba(0,0,0,.45);
}
.notfound-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 800;
  letter-spacing: -.03em;
  margin-bottom: .75rem;
}
.notfound-desc {
  font-family: var(--mono);
  font-size: .85rem;
  color: var(--muted);
  margin-bottom: 2rem;
}
</style>
